    "ts-jest": "^29.1.2",
    "typescript": "*"
  },
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-react",
      "@babel/preset-typescript"
    ]
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
